NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare R2 (imágenes de preguntas). Las R2_* son solo del servidor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (dominio propio o r2.dev), sin barra final.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Clave service_role de Supabase (Settings → API). Solo del servidor: la usa /api/socios para crear cuentas. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini (armar quizzes con IA). Clave gratis en https://aistudio.google.com/apikey. Solo del servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: otro modelo de Gemini (por defecto gemini-3.8-flash).
GEMINI_MODEL=
